# Kopiér denne filen til `.env.local` og fyll inn verdiene.
# .env.local er i .gitignore og blir aldri committet.

# ---- Supabase (Fase 5) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Stripe (Fase 6) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---- Resend e-post (Fase 7 + frivilligskjema) ----
# Brukes både til billett-kvitteringer (senere) og til å sende
# oppsummerings-e-post fra frivilligskjemaet (/api/frivillig).
RESEND_API_KEY=
# Verifisert avsender hos Resend. Under testing kan du bruke
# "Kultursjokk <onboarding@resend.dev>" uten eget domene.
EMAIL_FROM=billetter@kultursjokk.no

# ---- Frivilligskjema: Google Sheet-logg (valgfritt) ----
# URL til en Google Apps Script-web-app som legger hver påmelding
# til som en rad i et regneark. Se
# docs/2026-07-01-frivilligskjema-oppsett.md for oppsett.
# La stå tom for å kun bruke e-post.
GOOGLE_SHEET_WEBHOOK_URL=

# ---- Sidekonfigurasjon ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
